{
  "name": "vite-plugin-react-source-string",
  "version": "0.1.0",
  "description": "Native Vite plugin that adds data-source=\"path:line\" attributes to JSX elements (React/UI components and HTML elements) for debugging",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "react",
    "jsx",
    "data-source",
    "debug"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanchu/vite-plugin-react-source.git"
  },
  "bugs": {
    "url": "https://github.com/tanchu/vite-plugin-react-source/issues"
  },
  "homepage": "https://github.com/tanchu/vite-plugin-react-source#readme",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "dependencies": {
    "magic-string": "^1.4.5",
    "oxc-parser": "^0.158.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^9.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.21.0"
}
